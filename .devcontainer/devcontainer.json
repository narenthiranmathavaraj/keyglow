{
  "name": "Tiny Chip, Two Brains: Bare Metal and RTOS firmware (STM32F100 on QEMU)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "git submodule update --init --recursive && make doctor; pip3 install pygments --break-system-packages; wget -qO ~/.gdbinit https://git.io/.gdbinit || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-vscode.makefile-tools",
        "ZixuanWang.linkerscript",
        "davidbwaters.macos-modern-theme",
        "maziac.hex-hover-converter",
        "ms-vscode.hexeditor",
        "trond-snekvik.gnu-mapfiles",
        "joshuabernstein.armextensionhelpers"
      ],
      "settings": {
        "editor.fontSize": 16,
        "terminal.integrated.fontSize": 16,
        "workbench.iconTheme": "vs-seti",
        "editor.minimap.enabled": false,
        "workbench.colorTheme": "MacOS Modern Dark - Ventura Xcode Default",
        "workbench.preferredDarkColorTheme": "MacOS Modern Dark - Ventura Xcode Default",
        "editor.wordWrapColumn": 120,
        "workbench.startupEditor": "none",
        "editor.useTabStops": false,
        "files.trimTrailingWhitespace": true,
        "git.autorefresh": false,
        "terminal.integrated.cursorBlinking": true,
        "terminal.integrated.cursorStyle": "line",
        "debug.console.fontSize": 16,
        "editor.rulers": [120],
        "terminal.integrated.sendKeybindingsToShell": true,
        "extensions.ignoreRecommendations": true,
        "remote.autoForwardPorts": false
      }
    }
  }
}
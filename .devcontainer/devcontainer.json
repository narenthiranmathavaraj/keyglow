{
  "name": "KeyGlow firmware (STM32F100 on QEMU)",
  "build": { "dockerfile": "Dockerfile" },
  "postCreateCommand": "./scripts/bootstrap.sh && make doctor",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-python.python", "ms-vscode.makefile-tools"],
      "settings": {
        "C_Cpp.default.compilerPath": "/usr/bin/arm-none-eabi-gcc",
        "C_Cpp.default.intelliSenseMode": "gcc-arm",
        "files.insertFinalNewline": true
      }
    }
  }
}
